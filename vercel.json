{
  "rewrites": [
    {
      "source": "/byteplus-api/:path*",
      "destination": "https://ark.ap-southeast.bytepluses.com/:path*"
    },
    {
      "source": "/mst-api/:path*",
      "destination": "https://api.vietqr.io/v2/business/:path*"
